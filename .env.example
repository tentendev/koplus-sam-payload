# Copy this file to `.env` for local development.
# In production (Vercel), set these as environment variables in the project settings.

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (SQLite, file-based):
DATABASE_URI=file:./payload.db
# Production (Postgres, e.g. Neon):
# DATABASE_URI=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Payload secret ────────────────────────────────────────────────────────
# Used to sign auth tokens. Generate a strong random string for production.
# e.g., `openssl rand -hex 32`
PAYLOAD_SECRET=replace-me-with-a-long-random-string
